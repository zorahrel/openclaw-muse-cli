{
  "name": "openclaw-muse-cli",
  "version": "0.5.0",
  "description": "Run Muse Spark inside OpenClaw via the local muse CLI subscription, with host MCP tools",
  "repository": "github:zorahrel/openclaw-muse-cli",
  "license": "MIT",
  "author": "Attilio Cianci",
  "type": "module",
  "keywords": ["openclaw", "openclaw-plugin", "muse", "cli-backend"],
  "files": [
    "index.ts",
    "lib.ts",
    "proxy.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/parse.test.mjs && node test/proxy.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  }
}
