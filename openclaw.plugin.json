{
  "id": "muse-cli",
  "name": "Muse CLI",
  "description": "Run Muse Spark via the local muse CLI subscription",
  "categories": [
    "agent-runtimes"
  ],
  "cliBackends": [
    "muse-cli"
  ],
  "setup": {
    "cliBackends": [
      "muse-cli"
    ],
    "requiresRuntime": true
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "role": {
        "type": "string",
        "description": "Optional role prepended to the full OpenClaw system prompt."
      },
      "memoryFiles": {
        "type": "array",
        "description": "Absolute file paths appended after the role.",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "chars": {
                  "type": "number"
                },
                "header": {
                  "type": "string"
                }
              }
            }
          ]
        }
      },
      "memoryChars": {
        "type": "number",
        "description": "Per-file char cap when the entry sets none (default 4000)."
      },
      "separator": {
        "type": "string",
        "description": "Line between the optional prefix and the OpenClaw system prompt."
      }
    }
  },
  "modelCatalog": {
    "providers": {
      "muse-cli": {
        "models": [
          {
            "id": "muse-spark-1.3",
            "name": "Muse Spark 1.3 (Muse CLI)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "compat": {
              "supportedReasoningEfforts": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        ]
      }
    }
  }
}
